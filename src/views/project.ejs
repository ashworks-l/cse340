<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (project) { %>

        <h2><%= project.title %></h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.date %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <section>

            <h3>Categories</h3>

            <% if (categories.length > 0) { %>

                <div class="category-tags">

                    <% categories.forEach(category => { %>

                        <a
                            href="/category/<%= category.category_id %>"
                            class="category-tag"
                        >
                            <%= category.name %>
                        </a>

                    <% }); %>

                </div>

            <% } else { %>

                <p>No categories assigned to this project.</p>

            <% } %>

        </section>

    <% } else { %>

        <h2>Service Project Not Found</h2>

        <p>
            The service project you requested does not exist.
        </p>

        <p>
            <a href="/service-projects">
                Return to service projects
            </a>
        </p>

    <% } %>

</main>

<%- include('partials/footer') %>