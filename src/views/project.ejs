<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (project) { %>

        <h2><%= project.title %></h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.date %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

    <% } else { %>

        <h2>Service Project Not Found</h2>

        <p>
            The service project you requested does not exist.
        </p>

        <p>
            <a href="/service-projects">
                Return to service projects
            </a>
        </p>

    <% } %>

</main>

<%- include('partials/footer') %>