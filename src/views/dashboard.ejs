
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>

    <p>Name: <%= name %></p>

    <p>Username: <%= email %></p>

    <% if (role_name === 'admin') { %>
        <section class="dashboard-card">
            <h2>User Management</h2>
            <p>View all registered users and their roles.</p>
            <a href="/users">Manage Registered Users</a>
        </section>
    <% } %>
</main>

<%- include('partials/footer') %>
