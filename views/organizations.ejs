<%- include("partials/header") %>

<section class="page-header">

    <p class="eyebrow">OUR COMMUNITY</p>

    <h1>Organizations</h1>

    <p>
        Explore organizations that provide meaningful opportunities
        to serve and strengthen our communities.
    </p>

</section>

<section class="section">

    <div class="organization-grid">

        <% if (organizations && organizations.length > 0) { %>

            <% organizations.forEach(organization => { %>

                <article class="organization-card">

                    <img
                        src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo"
                    >

                    <div class="organization-content">

                        <h2>
                            <%= organization.name %>
                        </h2>

                        <p>
                            <%= organization.description %>
                        </p>

                        <p>
                            <strong>Email:</strong>
                            <%= organization.contact_email %>
                        </p>

                        <a href="/service-projects" class="text-link">
                            View projects →
                        </a>

                    </div>

                </article>

            <% }); %>

        <% } else { %>

            <p>No organizations are currently available.</p>

        <% } %>

    </div>

</section>

<%- include("partials/footer") %>