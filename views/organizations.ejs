<%- include("partials/header") %>

<section class="page-header">
    <p class="eyebrow">OUR COMMUNITY</p>
    <h1>Organizations</h1>
    <p>
        Explore organizations that provide meaningful opportunities
        to serve and strengthen our communities.
    </p>
</section>

<section class="section">

    <div class="organization-grid">

        <article class="organization-card">
            <img
                src="/images/environmental.jpg"
                alt="Volunteers working together in a natural environment"
            >

            <div class="organization-content">
                <h2>Green Community Initiative</h2>

                <p>
                    An organization dedicated to environmental conservation,
                    clean-up projects, and community sustainability.
                </p>

                <a href="/service-projects" class="text-link">
                    View projects →
                </a>
            </div>
        </article>


        <article class="organization-card">
            <img
                src="/images/educational.jpg"
                alt="Volunteer helping students with education"
            >

            <div class="organization-content">
                <h2>Education for All</h2>

                <p>
                    A community organization focused on helping students
                    and providing educational support.
                </p>

                <a href="/service-projects" class="text-link">
                    View projects →
                </a>
            </div>
        </article>


        <article class="organization-card">
            <img
                src="/images/community.jpg"
                alt="Community volunteers working together"
            >

            <div class="organization-content">
                <h2>Community Care Network</h2>

                <p>
                    Volunteers working together to support families,
                    neighborhoods, and community programs.
                </p>

                <a href="/service-projects" class="text-link">
                    View projects →
                </a>
            </div>
        </article>

    </div>

</section>

<%- include("partials/footer") %>